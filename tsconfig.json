{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],

    // CommonJS rather than the ESM used by atlas-manager: NestJS's supported
    // path is CJS, and its CLI and parts of the ecosystem assume it.
    // See docs/adr/002.
    //
    // nodenext rather than the classic commonjs/node pair: package.json
    // declares no "type", so nodenext resolves and emits CommonJS anyway, and
    // the legacy "node" resolution is deprecated in TypeScript 6, removed in 7.
    //
    // nodenext rather than node16 because it models require() of ESM, which
    // Node has supported unflagged since 22.12.0. That is what lets an
    // ESM-only dependency be imported from CommonJS without a .mts wrapper.
    "module": "nodenext",
    "moduleResolution": "nodenext",

    // NestJS dependency injection resolves constructor parameter types from
    // metadata emitted by these two flags.
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,

    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,

    "outDir": "dist",
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "noEmit": true
  },
  // vitest.config.ts is listed so the project has at least one input file
  // before src/ exists, and so the config itself is typechecked.
  "include": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist"]
}
