# Catho collector — environment template (ADR-032)
#
# Copy to .env in this directory and fill in. .env is gitignored; this file
# is not. Consumed by systemd's EnvironmentFile= (argos-catho-collect.service),
# not by argos-career's own .env — this runs as a fully separate process.

# --- argos-career's ingest endpoint -------------------------------------------
# Atlas's Tailscale address and port — the same one Hermes and the Indeed
# collector reach, from the same machine this script runs on (Atlas's host,
# not inside any container).
ARGOS_API_URL=http://100.x.x.x:3000

# Catho-only credential. Its matching server-side value is
# INGEST_CATHO_API_KEY; it cannot call scoring, Telegram or other sources.
ARGOS_INGEST_API_KEY=

# --- Crawl parameters (all optional, shown with their defaults) --------------
# How many not-yet-seen postings to open per run. Bounded on purpose — the
# nationwide backlog is ~6,800 candidate postings (measured 2026-08-17); at
# 300/run with the timer's 30-minute cadence, draining it takes roughly a
# day, spread out rather than one multi-hour process. Ordinary runs after
# the backlog drains only see each day's new postings, a few hundred at
# most.
# MAX_PAGES_PER_RUN=300

# Pause between opening posting pages (CLAUDE.md 6).
# REQUEST_INTERVAL_MS=1500

# Page outcomes persisted per checkpoint. Must be a positive integer.
# CHECKPOINT_EVERY=10

# Regex (case-insensitive) matched against each sitemap URL to decide which
# postings are worth opening at all — this is the only filter available;
# Catho's search page is robots.txt-disallowed, so there is no server-side
# way to narrow by location. See docs/adr/032-catho-collector-headless-browser.md.
# TITLE_PATTERN=estagio|estagiario|estagiaria|estágio|estagiário|estagiária|trainee

# Where the checkpoint state file lives *inside the container* — must line
# up with the volume mount in the docker run command below, so progress
# survives between --rm runs. Per-ID state (collected/ingested/expired/
# retryable/quarantined, docs/audit AC-001/AC-002) — not just a seen-set.
# STATE_PATH=/data/catho-state.json
