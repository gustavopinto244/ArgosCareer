# ArgosCareer — environment template
#
# Copy to .env and fill in. .env is gitignored; this file is not.
# Only credentials and endpoints belong here. Anything that is a *decision*
# belongs in config/criteria.yaml, where it can be diffed. See
# docs/09-configuration.md.

# --- Telegram delivery -------------------------------------------------------
# Bot token from @BotFather. Required.
TELEGRAM_BOT_TOKEN=000000000:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Chat that receives the digest and alerts. Required.
TELEGRAM_CHAT_ID=000000000

# --- Scoring engine ----------------------------------------------------------
# Which ScorerPort adapter to use: stub | api | ollama
# stub   — fixed score, no model. Used by tests and the M6 vertical slice.
# api    — hosted model. The calibration baseline: iterates fast enough to
#          actually finish M7.
# ollama — local model on Atlas. The production target.
SCORER_ADAPTER=stub

# Required when SCORER_ADAPTER=api. OpenRouter key (ADR-012) — a single
# OpenAI-compatible endpoint in front of many providers, so comparing
# candidate models during M7 calibration is a config change (LLM_MODEL),
# never an adapter change.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1

# Model tag/slug. Used by both SCORER_ADAPTER=api (an OpenRouter model
# slug, e.g. openrouter/auto) and SCORER_ADAPTER=ollama (a local model tag,
# e.g. qwen3:4b) — whichever adapter is active reads this.
LLM_MODEL=

# Required when SCORER_ADAPTER=ollama.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# The model is unloaded from memory automatically once a deliver batch
# finishes (OllamaClient.unload, called from the CLI) — not a setting here.
# Ollama peaks around 3.2 GB and Atlas budgets ~150 MB at rest; CLAUDE.md
# section 5.

# --- Long-tail sources via n8n (ADR-008) -------------------------------------
# An n8n workflow handles one long-tail source and returns RawPosting JSON.
# n8n is never the orchestrator and never on the critical path: if it is down,
# N8nCollector returns an empty CollectionResult with an error and the digest
# still goes out. Leave blank to disable.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=

# --- Storage -----------------------------------------------------------------
# SQLite file. Gitignored; back it up (M8).
DATABASE_PATH=./data/argos.db

# --- Logging -----------------------------------------------------------------
# error | warn | info | debug — see docs/08-observability.md
LOG_LEVEL=info
