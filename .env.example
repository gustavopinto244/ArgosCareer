# ArgosCareer — environment template
#
# Copy to .env and fill in. .env is gitignored; this file is not.
# Only credentials and endpoints belong here. Anything that is a *decision*
# belongs in config/criteria.yaml, where it can be diffed. See
# docs/09-configuration.md.

# --- Telegram delivery -------------------------------------------------------
# Bot token from @BotFather. Required.
TELEGRAM_BOT_TOKEN=000000000:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Chat that receives the digest and alerts. Required.
TELEGRAM_CHAT_ID=000000000

# --- Scoring engine ----------------------------------------------------------
# Which ScorerPort adapter to use: stub | api
# stub — fixed score, no model. Used by tests and the M6 vertical slice.
# api  — hosted model (OpenRouter). Production (ADR-012/013/016). A local
#        model (OllamaScorer) was evaluated during M7/M8 and retired — it
#        never finished a real calibration pass, and `api`'s real measured
#        cost and memory footprint (cents per batch, ~30 MiB at rest on
#        Atlas) left no case for running a model on shared hardware. See
#        ADR-016 for the full reasoning.
SCORER_ADAPTER=stub

# Required when SCORER_ADAPTER=api. OpenRouter key (ADR-012) — a single
# OpenAI-compatible endpoint in front of many providers, so comparing
# candidate models during calibration is a config change (LLM_MODEL), never
# an adapter change.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1

# OpenRouter model slug, e.g. deepseek/deepseek-v4-flash-0731.
LLM_MODEL=

# --- Long-tail sources via n8n (ADR-008) -------------------------------------
# An n8n workflow handles one long-tail source and returns RawPosting JSON.
# n8n is never the orchestrator and never on the critical path: if it is down,
# N8nCollector returns an empty CollectionResult with an error and the digest
# still goes out. Leave blank to disable.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=

# --- Storage -----------------------------------------------------------------
# SQLite file. Gitignored; back it up (M8).
DATABASE_PATH=./data/argos.db

# --- HTTP API (M9) ------------------------------------------------------------
# Hermes runs on a different machine, not Atlas (CLAUDE.md §10), so this is a
# real network boundary — every route requires this key as
# `Authorization: Bearer <API_KEY>` (ApiKeyGuard). Required; the process
# refuses to start without it (docs/09-configuration.md rule 1). Generate
# with e.g. `openssl rand -hex 32`.
API_KEY=
# Port the HTTP server listens on inside the container. Bound to Atlas's
# Tailscale interface at the compose level (compose.production.yaml), not
# exposed publicly.
API_PORT=3000

# --- Logging -----------------------------------------------------------------
# error | warn | info | debug — see docs/08-observability.md
LOG_LEVEL=info
