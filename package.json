{
  "name": "argos-career",
  "version": "0.1.0",
  "description": "Collects internship postings, scores them against a master profile and delivers a ranked digest to Telegram.",
  "private": true,
  "license": "MIT",
  "author": "Gustavo Pinto",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "argos": "dist/cli/main.js"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "cli": "tsx src/cli/main.ts",
    "fixture:gupy": "tsx scripts/fixture-gupy.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "measure:prefilter": "tsx scripts/measure-prefilter-cut.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "job-search",
    "llm",
    "typescript",
    "nestjs",
    "hexagonal-architecture"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/testing": "^11.2.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ulid": "^3.0.2",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
